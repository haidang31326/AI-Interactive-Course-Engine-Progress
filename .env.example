# ==============================================================================
# AI Interactive Course Engine - Environment Variables Template
# Copy this file to .env and replace with your real secrets:
# cp .env.example .env
# ==============================================================================

# Gemini AI API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Database MySQL Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/course_engine?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password

# Kafka Broker Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Firebase OAuth2 JWT Resource Server
FIREBASE_ISSUER_URI=https://securetoken.google.com/your-firebase-project-id
FIREBASE_JWK_SET_URI=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
